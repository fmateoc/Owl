+    def _ball(self, x):
+        """The constraint matrix plus a local-branching row: at most `radius` SS binaries flipped from x."""
+        A = copy.deepcopy(self.plan.A)
+        row, ones = {}, 0
+        for c in self._cols("zs"):
+            if round(x[c]) >= 1:
+                row[int(c)] = -1.0
+                ones += 1
+            else:
+                row[int(c)] = 1.0
+        A.addNewRow(row, -np.inf, self.radius - ones, tag=("local_branching", 0))
+        return A
+
