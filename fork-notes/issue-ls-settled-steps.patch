+@pytest.mark.toml
+def test_a_settled_search_skips_its_capped_steps(monkeypatch):
+    """An iteration that follows one whose search started from the binaries it was handed and moved
+    none of them runs the cheap steps only: (b), (b') and (a') found nothing on those binaries, and
+    the problem differs by the loop's fed-back parameters alone."""
+    from owlplanner.plan import Plan
+
+    real = Plan._check_obj_convergence
+    # Four loop iterations, each a new problem (none reused): a repair start, then three from the
+    # previous binaries.
+    monkeypatch.setattr(Plan, "_check_obj_convergence",
+                        lambda self, it, *a, **k: None if it < 3 else real(self, it, *a, **k))
+    fresh = iter(range(1_000_000))
+    monkeypatch.setattr(localsearch.LocalSearch, "_fingerprint", lambda self: next(fresh))
+    p = _load("Case_bill.toml")
+    p.solve(p.objective, options={**p.solverOptions, "breakpointMethod": "local-search"})
+    assert p.caseStatus == "solved"
+    capped = ("(b)", "(b')", "(a')")
+    labels = [[s["step"].split(": ")[0] for s in it["steps"]] for it in p.localSearchLog]
+    assert len(labels) >= 4, labels
+    assert not labels[0][0].startswith("start: previous") and any(x.endswith(capped) for x in labels[0])
+    assert labels[1][0] == "start" and any(x.endswith(capped) for x in labels[1]), labels[1]
+    second = p.localSearchLog[1]["steps"]
+    start = second[0]["objective"]
+    assert all(s["objective"] >= start - 1e-7 * abs(start) for s in second if s["ok"]), "it moved: nothing to test"
+    for later in labels[2:]:
+        assert later[0] == "start" and any(x.endswith("(a)") for x in later), later
+        assert not any(x.endswith(capped) for x in later), later
+
+
