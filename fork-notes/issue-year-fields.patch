+def _moved_text(label, old, new, low, high):
+    """A clamped year in words: "Year to stop considering Roth conversions: 2500 is past the
+    plan's last year, 2053; shown as 2053"."""
+    where = (f"past the plan's last year, {high}" if old > high
+             else f"before the plan's first year, {low}")
+    return f"{label}: {old} is {where}; shown as {new}"
+
+
+def _onAcaFromStart():
+    """The marketplace toggle: on stores 0 ("from the plan start"); off stores next year (the
+    plan's last at most) for the year box to show."""
+    on = st.session_state.get(kz.genCaseKey("acaFromPlanStart"))
+    plan = kz.getCaseKey("plan")
+    years = getattr(plan, "year_n", None) if plan is not None else None
+    end = int(years[-1]) if years is not None and len(years) else date.today().year + 40
+    year = 0 if on else min(date.today().year + 1, end)
+    kz.setCaseKey("acaStartYear", year)
+    st.session_state[kz.genCaseKey("acaStartYear")] = year
+
+
+def _bound_year(key, low, high):
+    """Clamp a stored year field into [low, high] before its widget draws it, so the case keeps
+    what the field shows. A move up to the lower bound keeps the meaning (a year before the
+    plan's first year means "from its first year") and the case's status; a move down to the
+    upper bound changes it (a year past the plan said "never"), so the case is flagged modified.
+    Returns the old value when one moved, else None."""
+    value = kz.getCaseKey(key)
+    if value is None:
+        return None
+    try:
+        year = int(value)
+    except (TypeError, ValueError):
+        return None
+    if low <= year <= high:
+        return None
+    moved = min(max(year, low), high)
+    if year > high:
+        kz.setCaseKey(key, moved)
+    else:
+        kz.storeCaseKey(key, moved)
+    return year
+
+
