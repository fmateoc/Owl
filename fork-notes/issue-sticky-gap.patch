+def test_a_tie_does_not_take_the_plan_outside_the_requested_gap(plan, monkeypatch):
+    """A tie within relTol (5e-5) but worth more than the room left in a gap the solve met: the kept
+    plan would sit 1.19e-5 from the solver's bound against a requested 1e-5."""
+    x, prev, _ = _with_prev(plan, flip=True)
+    monkeypatch.setattr(plan, "_run_mip", lambda *a, **k: (-1.0 + 2e-6, prev, True, "pinned LP", -1.0))
+    result = (-1.0, x, True, "MIP", 9.9e-6)
+    assert plan._stickyBinaries(result, {"gap": 1e-5}, use_mosek=False) is result
+    assert np.array_equal(plan._stickyPrev, x)
+
+
+def test_a_tie_inside_the_requested_gap_still_keeps_them(plan, monkeypatch):
+    x, prev, _ = _with_prev(plan, flip=True)
+    monkeypatch.setattr(plan, "_run_mip", lambda *a, **k: (-1.0 + 2e-6, prev, True, "pinned LP", -1.0))
+    obj, z, ok, msg, gap = plan._stickyBinaries((-1.0, x, True, "MIP", 5e-6), {"gap": 1e-5}, use_mosek=False)
+    assert np.array_equal(z, prev) and ok
+    assert gap == pytest.approx(7e-6, rel=1e-3) and gap <= 1e-5
+
+
 def test_the_same_binaries_are_not_solved_again(plan, monkeypatch):
     x, _, _ = _with_prev(plan, flip=False)
     monkeypatch.setattr(plan, "_run_mip", lambda *a, **k: pytest.fail("re-solved identical binaries"))
